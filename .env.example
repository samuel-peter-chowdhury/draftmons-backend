# Server
PORT=3000
NODE_ENV=development

# Database
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=your_db_password
DB_NAME=draftmons

# Session
SESSION_SECRET=your_session_secret_here

# Google OAuth
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:3000/api/auth/google/callback

# Client URL (frontend origin for OAuth redirects and CORS)
CLIENT_URL=http://localhost:3333

# Replay sources (optional) — extra hosts allowed as match-upload replay sources,
# comma-separated. Appended to the built-in allowlist in replay-fetcher.service.ts
# (replay.pokemonshowdown.com, champsnatdex.dedyn.io, sim.pokeathlon.com,
# staraptorshowdown.com). Any host not on the list is rejected before any fetch.
REPLAY_ALLOWED_HOSTS=

# Redis (production only)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Discord Bot Configuration
DISCORD_CLIENT_ID=
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=

# Discord OAuth Configuration
DISCORD_CLIENT_SECRET=
DISCORD_CALLBACK_URL=